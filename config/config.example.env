# Copy to config/config.local.env and edit for the execution system.
# Do not commit config.local.env.

PROJECT_ROOT=/path/to/project
REFERENCE=/path/to/chm13v2.0.fa
HIFIASM=/path/to/hifiasm
MINIMAP2=/path/to/minimap2
PAFTOOLS=/path/to/paftools.js
SAMTOOLS=/path/to/samtools
MINISV=/path/to/minisv
SNIFFLES2=/path/to/sniffles
LONGCALLD=/path/to/longcallD
TRGT=/path/to/trgt
TRGT_DENOVO=/path/to/trgt-denovo

# Initial assembly-derived comparison definition
ASSEMBLY_MIN_SVLEN=50
BREAKPOINT_TOLERANCE=100
SVLEN_TOLERANCE=50

# Minisv run specification used by the existing defaultbase table.
MINISV_SVLEN=100
MINISV_RATIO=0.8
MINISV_C=2
MINISV_UC=3
MINISV_G=5
MINISV_W=500
MINISV_M=0.6
MINISV_MAX_DIFF_LEN=1000
